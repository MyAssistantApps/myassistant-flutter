#!/usr/bin/env bash
# PRE-PUSH: never push over a teammate's work.
#
# Five people push to the same branches (one shared Claude account, so
# nobody can tell from the session who did what). Git already refuses a
# plain push that is behind; this also stops a FORCE push, and says what
# to do. Switched on by setup.sh (git config core.hooksPath .githooks).
#
# It fetches each branch being pushed and refuses when the remote has
# commits the push would drop. Fix: git pull --rebase, re-test, push.
set -euo pipefail
remote="$1"
zero=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref _remote_sha; do
  [ "$local_sha" = "$zero" ] && continue          # deleting a branch
  branch="${remote_ref#refs/heads/}"
  if ! git fetch -q "$remote" "$branch" 2>/dev/null; then
    continue                                      # a new branch: nothing to lose
  fi
  tip="$(git rev-parse FETCH_HEAD)"
  if ! git merge-base --is-ancestor "$tip" "$local_sha"; then
    behind="$(git rev-list --count "$local_sha..$tip")"
    echo "" >&2
    echo "pre-push: $remote/$branch has $behind commit(s) you do not have." >&2
    echo "  Pushing now would drop a teammate's work. First run:" >&2
    echo "    git pull --rebase $remote $branch" >&2
    echo "  then re-run the tests and push again. Never --force." >&2
    status=1
  fi
done
exit $status
