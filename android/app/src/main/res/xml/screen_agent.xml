<?xml version="1.0" encoding="utf-8"?>
<!-- The assistant's hands in other apps (ScreenAgentService.kt): it reads
     the screen and taps, types and scrolls only while a task the owner
     asked for is running, and asks before anything that sends or pays. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagReportViewIds|flagRetrieveInteractiveWindows|flagIncludeNotImportantViews"
    android:canRetrieveWindowContent="true"
    android:canPerformGestures="true"
    android:notificationTimeout="200"
    android:description="@string/screen_agent_description" />
